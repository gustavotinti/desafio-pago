rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos — owner only, 2 MB, images only
    match /profiles/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Entry files — image max 10 MB, video max 50 MB
    match /entries/{challengeId}/{fileName} {
      // get: o getDownloadURL logo após o upload precisa dele. list fechado:
      // não expõe os nomes dos arquivos (o app consome pelo downloadURL com
      // token, que não passa pelas rules).
      allow get: if request.auth != null;
      allow list: if false;
      // Arquivo amarrado ao dono: o app grava `{uid}_{timestamp}.ext`
      // (entry_repository). O painel admin grava `admin_{timestamp}.ext`
      // (admin_add_entry_page) — liberado só para quem está em /admins
      // (regra cross-service: exige a permissão Storage→Firestore).
      allow write: if request.auth != null
        && (fileName.matches(request.auth.uid + '_.*')
          || firestore.exists(
            /databases/(default)/documents/admins/$(request.auth.uid)))
        && (
          (request.resource.contentType.matches('image/.*')
            && request.resource.size < 10 * 1024 * 1024)
          ||
          (request.resource.contentType.matches('video/.*')
            && request.resource.size < 50 * 1024 * 1024)
        );
    }
  }
}
