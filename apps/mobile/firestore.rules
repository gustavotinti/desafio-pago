rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(uid()));
    }
    // Admin pleno = está em /admins e NÃO é moderador
    // (super admin não tem campo 'role' → conta como pleno).
    function isFullAdmin() {
      return isAdmin() &&
        get(/databases/$(database)/documents/admins/$(uid()))
            .data.get('role', 'super') != 'moderator';
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── USERS ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // PII (e-mail, telefone, saldo, Pix): só o dono e admins leem.
      // O público lê o espelho /publicProfiles (sem PII).
      allow read: if signedIn() && (uid() == userId || isAdmin());

      // First login: client may create own doc only with zero balances
      allow create: if signedIn() && uid() == userId
        && request.resource.data.balance == 0
        && request.resource.data.pendingBalance == 0
        && request.resource.data.lockedBalance == 0
        && request.resource.data.totalEarned == 0;

      // Owner: profile fields only. Os contadores de follow agora são movidos
      // exclusivamente pela função toggleFollow (Admin SDK) — sem escrita direta.
      allow update: if signedIn() && uid() == userId
          && changed().hasOnly(['name', 'bio', 'photoUrl', 'pixKey', 'fcmToken', 'termsAccepted'])

        // Admin (approve/reject withdrawals updates lockedBalance/balance)
        || isAdmin();

      // balance, pendingBalance, lockedBalance are managed exclusively
      // by Cloud Functions (Admin SDK) — no direct client writes allowed
    }

    // ── USERNAMES ─────────────────────────────────────────────────────────────
    match /usernames/{username} {
      // Any signed-in user can check availability
      allow read: if signedIn();
      // Client may claim a username on first login if it maps to their own uid
      allow create: if signedIn()
        && request.resource.data.uid == uid();
      // Owner can release their own username (handled when updating to a new one)
      allow delete: if signedIn() && resource.data.uid == uid();
      // Updates via Cloud Function (Admin SDK) only
    }

    // ── PUBLIC PROFILES (espelho sem PII — visível para visitantes) ───────────
    match /publicProfiles/{userId} {
      // Leitura pública: apenas nome, @username, foto, bio, ganhos, votos…
      // E-mail, telefone, saldo e Pix NÃO ficam aqui (continuam em /users).
      allow read: if true;
      // Mantido exclusivamente por Cloud Functions (Admin SDK).
      allow write: if false;
    }

    // ── CHALLENGES ───────────────────────────────────────────────────────────
    match /challenges/{challengeId} {
      // Conteúdo público: qualquer visitante pode ver os desafios.
      allow read: if true;

      // create, amount updates, voteCount, entryCount all handled by Cloud Functions
      allow update: if isAdmin();
    }

    // ── ENTRIES ──────────────────────────────────────────────────────────────
    match /entries/{entryId} {
      // Conteúdo público: qualquer visitante pode ver as participações.
      allow read: if true;

      // create and voteCount updates are handled exclusively by Cloud Functions (Admin SDK)
      allow update: if isAdmin() && changed().hasOnly(['isActive']);
    }

    // ── VOTES ─────────────────────────────────────────────────────────────────
    match /votes/{voteId} {
      allow read: if signedIn() && resource.data.userId == uid();

      // Writes handled exclusively by Cloud Functions (Admin SDK)
    }

    // ── WITHDRAWALS ──────────────────────────────────────────────────────────
    match /withdrawals/{withdrawalId} {
      allow read: if signedIn()
        && (resource.data.userId == uid() || isAdmin());

      // create handled by requestWithdraw Cloud Function (Admin SDK)
      // admin approve/reject updates status, approvedAt, approvedBy
      allow update: if isAdmin();
    }

    // ── TRANSACTIONS ─────────────────────────────────────────────────────────
    match /transactions/{txId} {
      allow read: if signedIn() && resource.data.userId == uid();
      // All transactions created by Cloud Functions (Admin SDK)
    }

    // ── NOTIFICATIONS (subcoleção do usuário) ─────────────────────────────────
    match /users/{userId}/notifications/{nid} {
      allow read: if signedIn() && uid() == userId;
      // O dono só pode marcar como lida; criação via Cloud Function (Admin SDK).
      allow update: if signedIn() && uid() == userId
        && changed().hasOnly(['read']);
      allow create, delete: if false;
    }

    // ── FOLLOWS ──────────────────────────────────────────────────────────────
    match /follows/{followId} {
      // Leitura p/ checar "estou seguindo?"; escrita só via toggleFollow (Admin SDK).
      allow read: if signedIn();
      allow write: if false;
    }

    // ── PAYMENTS ─────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      // Owner may read their own payment; Cloud Functions write via Admin SDK (bypasses rules)
      allow read: if signedIn() && resource.data.userId == uid();
      allow write: if false;
    }

    // ── VERIFICATION REQUESTS ─────────────────────────────────────────────────
    match /verificationRequests/{userId} {
      // Dados sensíveis (CPF, telefone): só o dono e admins podem ler.
      allow read: if signedIn() && (userId == uid() || isAdmin());
      // Todas as escritas passam por Cloud Functions (Admin SDK).
      allow write: if false;
    }

    // ── ADMINS ───────────────────────────────────────────────────────────────
    match /admins/{userId} {
      allow read: if signedIn();
      // Só admin pleno gerencia o roster (moderador não escala privilégio).
      allow write: if isFullAdmin();
    }

    // ── COMMENTS ─────────────────────────────────────────────────────────────
    match /comments/{commentId} {
      // Conteúdo público; criação de comentário via Cloud Function (exige login)
      allow read: if true;
      allow write: if false;
    }

    // ── COMMENT LIKES ─────────────────────────────────────────────────────────
    match /commentLikes/{likeId} {
      // Usuário logado consulta os próprios likes; escrita via Cloud Function.
      allow read: if signedIn();
      allow write: if false;
    }

    // ── INSTAGRAM POSTS ──────────────────────────────────────────────────────
    match /instagram_posts/{postId} {
      // Read-only for admins; all writes via Cloud Functions (Admin SDK)
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── REPORTS ──────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Admin can read/update; users create via reportContent Cloud Function
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── AUDIT LOGS ───────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      // Read-only for admins; all writes via Cloud Functions (Admin SDK)
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
