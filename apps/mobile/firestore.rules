rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(uid()));
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── USERS ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if signedIn();

      // Owner: profile fields only
      allow update: if signedIn() && uid() == userId
          && changed().hasOnly(['name', 'bio', 'photoUrl', 'pixKey'])

        // Owner: followingCount (follow/unfollow)
        || (signedIn() && uid() == userId
            && changed().hasOnly(['followingCount']))

        // Any auth user: target's followersCount (follow/unfollow)
        || (signedIn() && changed().hasOnly(['followersCount']))

        // Admin (approve/reject withdrawals updates lockedBalance/balance)
        || isAdmin();

      // balance, pendingBalance, lockedBalance are managed exclusively
      // by Cloud Functions (Admin SDK) — no direct client writes allowed
    }

    // ── CHALLENGES ───────────────────────────────────────────────────────────
    match /challenges/{challengeId} {
      allow read: if signedIn();

      // create, amount updates, voteCount, entryCount all handled by Cloud Functions
      allow update: if isAdmin();
    }

    // ── ENTRIES ──────────────────────────────────────────────────────────────
    match /entries/{entryId} {
      allow read: if signedIn();

      // create and voteCount updates are handled exclusively by Cloud Functions (Admin SDK)
      allow update: if isAdmin() && changed().hasOnly(['isActive']);
    }

    // ── VOTES ─────────────────────────────────────────────────────────────────
    match /votes/{voteId} {
      allow read: if signedIn() && resource.data.userId == uid();

      // Writes handled exclusively by Cloud Functions (Admin SDK)
    }

    // ── WITHDRAWALS ──────────────────────────────────────────────────────────
    match /withdrawals/{withdrawalId} {
      allow read: if signedIn()
        && (resource.data.userId == uid() || isAdmin());

      // create handled by requestWithdraw Cloud Function (Admin SDK)
      // admin approve/reject updates status, approvedAt, approvedBy
      allow update: if isAdmin();
    }

    // ── TRANSACTIONS ─────────────────────────────────────────────────────────
    match /transactions/{txId} {
      allow read: if signedIn() && resource.data.userId == uid();
      // All transactions created by Cloud Functions (Admin SDK)
    }

    // ── FOLLOWS ──────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.followerId == uid()
        && followId == uid() + '_' + request.resource.data.followedId;

      allow delete: if signedIn() && resource.data.followerId == uid();
    }

    // ── PAYMENTS ─────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      // Owner may read their own payment; Cloud Functions write via Admin SDK (bypasses rules)
      allow read: if signedIn() && resource.data.userId == uid();
      allow write: if false;
    }

    // ── ADMINS ───────────────────────────────────────────────────────────────
    match /admins/{userId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── INSTAGRAM POSTS ──────────────────────────────────────────────────────
    match /instagram_posts/{postId} {
      // Read-only for admins; all writes via Cloud Functions (Admin SDK)
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── REPORTS ──────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Admin can read/update; users create via reportContent Cloud Function
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── AUDIT LOGS ───────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      // Read-only for admins; all writes via Cloud Functions (Admin SDK)
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
