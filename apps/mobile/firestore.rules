rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(uid()));
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── USERS ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if signedIn();

      // Owner: update profile fields only
      allow update: if signedIn() && uid() == userId
          && changed().hasOnly(['name', 'bio', 'photoUrl', 'pixKey'])

        // Owner: decrease own balance only (withdrawal deduction)
        || (signedIn() && uid() == userId
            && changed().hasOnly(['balance'])
            && request.resource.data.balance < resource.data.balance)

        // Owner: update own followingCount (follow/unfollow)
        || (signedIn() && uid() == userId
            && changed().hasOnly(['followingCount']))

        // Any user: update target's followersCount (follow/unfollow transaction)
        || (signedIn() && changed().hasOnly(['followersCount']))

        // Admin: unrestricted
        || isAdmin();
    }

    // ── CHALLENGES ───────────────────────────────────────────────────────────
    match /challenges/{challengeId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && request.resource.data.amount > 0
        && request.resource.data.status == 'active'
        && request.resource.data.keys()
             .hasAll(['title', 'description', 'createdBy', 'amount',
                      'status', 'expiresAt', 'voteCount', 'entryCount']);

      // Aporte: any user may increase amount
      // voteCount and entryCount are now updated exclusively by Cloud Functions (Admin SDK)
      allow update: if signedIn()
          && changed().hasOnly(['amount'])
          && request.resource.data.amount > resource.data.amount

        // Admin / Cloud Functions: unrestricted (status, winnerIds, finishedAt)
        || isAdmin();
    }

    // ── ENTRIES ──────────────────────────────────────────────────────────────
    match /entries/{entryId} {
      allow read: if signedIn();

      // create and voteCount updates are handled exclusively by Cloud Functions (Admin SDK)
      allow update: if isAdmin() && changed().hasOnly(['isActive']);
    }

    // ── VOTES ─────────────────────────────────────────────────────────────────
    match /votes/{voteId} {
      allow read: if signedIn() && resource.data.userId == uid();

      // Writes handled exclusively by Cloud Functions (Admin SDK)
    }

    // ── WITHDRAWALS ──────────────────────────────────────────────────────────
    match /withdrawals/{withdrawalId} {
      allow read: if signedIn()
        && (resource.data.userId == uid() || isAdmin());

      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.amount >= 100;

      // Only admin may approve or reject
      allow update: if isAdmin()
        && changed().hasOnly(['status', 'approvedAt', 'approvedBy']);
    }

    // ── TRANSACTIONS ─────────────────────────────────────────────────────────
    match /transactions/{txId} {
      allow read: if signedIn() && resource.data.userId == uid();

      // Client writes withdrawal transactions; rewards written by Cloud Functions
      allow create: if signedIn() && request.resource.data.userId == uid();

      // Transactions are immutable — no update or delete
    }

    // ── FOLLOWS ──────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.followerId == uid()
        && followId == uid() + '_' + request.resource.data.followedId;

      allow delete: if signedIn() && resource.data.followerId == uid();
    }

    // ── PAYMENTS ─────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      // Owner may read their own payment; Cloud Functions write via Admin SDK (bypasses rules)
      allow read: if signedIn() && resource.data.userId == uid();
      allow write: if false;
    }

    // ── ADMINS ───────────────────────────────────────────────────────────────
    match /admins/{userId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
